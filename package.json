    "@fontsource/unbounded": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fflate": "^0.8.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
